{
	"folders":
	[
		{
			"path": ".",
            "follow_symlinks": true,
		}
	],
	"settings": //в т.ч. переопределяет пользовательские Settings
    {
        //"tab_size": 8,
        "sublimegdb_workingdir": "${project_path:Build/}",
        "sublimegdb_commandline": "arm-none-eabi-gdb --interpreter=mi *.elf",
    },
	"build_systems": //встроенные определения Build Systems
    [
        {
            "name": "MyCMakeSUBLPRJ", //MyCMake.sublime-build
            "working_dir": "${project_path}",
            "shell_cmd": "cmake -B Debug && cmake --build Debug; echo =$?",
            //"cmd": ["pwd"],
            "file_regex": "^(..[^:\n]*):([0-9]+):?([0-9]+)?:? (.*)$", //F4, Shift+F4
            //"file_regex": "^(.*):(\\d+):(\\d+):\\s*(.*)$",//F4, Shift+F4
            "keyfiles": ["CMakeLists.txt", "*.cmake", "MyARM.sublime-project"],
            "variants":
            [
                {
                    "name": "Clean",
                    "shell_cmd": "rm -rf Debug"
                },
                {
                    "name": "Clean, build, program",
                    "shell_cmd": "rm -rf Debug; cmake -B Debug && cmake --build Debug && cmake --build Debug --target program; echo =$?"
                    //"shell_cmd": "openocd -f board/st_nucleo_f0.cfg -c \"program Debug/elf verify reset exit\""
                    //arm-none-eabi-objcopy -O binary -S o.elf o.bin
                },
                {
